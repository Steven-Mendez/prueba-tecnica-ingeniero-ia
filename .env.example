# Copiar a .env para sobrescribir valores en local (en FastAPI Cloud se configuran en el panel).
# Las rutas son relativas a la raíz del repo.

APP_NAME="Prototipos · Casa Pellas"

# Caso 1 · pedido a fábrica
FACTORY_ORDER_EXCEL=data/raw/caso1_vehiculos_nuevos.xlsx
NOTEBOOK_ORDER_CSV=outputs/pedido_2026-10_por_modelo.csv
PLANS_DIR=data/plans

# Caso 2 · cola de renovaciones (la bitácora de resultados registrados desde la app es un JSON por registro)
RENEWALS_EXCEL=data/raw/caso2_renovaciones.xlsx
RENEWALS_NOTEBOOK_CSV=outputs/cola_renovaciones_2026-09-15.csv
CONTACT_LOG_DIR=data/contact_log

# Asistente (agente sobre el planificador): basta una de las dos claves. Sin clave, el chat lo indica y el
# resto funciona igual. AGENT_PROVIDER (openai|anthropic) elige si hay las dos; AGENT_MODEL cambia el modelo
# por defecto (gpt-5.5 o claude-opus-5-5) y AGENT_MODELS (lista separada por comas) los del selector del chat.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENT_PROVIDER=auto
# AGENT_MODEL=
# AGENT_MODELS=
